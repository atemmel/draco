#!/bin/cherry

output      := draco
output-path := build/draco
includes    := [ -Iinclude -I/usr/include/freetype2 ]
libs        := [ -lSDL3 -lfreetype -lstdc++exp ]
src         := src/*.cpp

cmds := [
    cachegrind = rest -> (valgrind "--tool=cachegrind" $output-path $rest)
    debug      = rest -> (seergdb -s $output-path $rest)
    leaks      = rest -> (valgrind "--leak-check=full" "--suppressions=suppress" $output-path $rest)
    perf       = rest -> (perf record -g -- $output-path)
    run        = rest -> (exec $output-path $rest)
]

mkdir -p build

#TODO: make parallel cached .o build with gnu parallel
_, status := (g++ $src -o $output-path $libs $includes -g -std=c++23)

if (len $argv) == 0 || $status != 0 {
    exit 0
}

arg  := (get $argv 0)
rest := (slice $argv 1 (len $argv))

if (has $cmds $arg) {
    $cmds'$arg $rest
} else {
    say "No idea what you meant with '{arg}', but hey, at least your stuff builds, right?"
}
